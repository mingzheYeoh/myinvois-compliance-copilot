# Local dev: matches docker-compose.yml. Azure PostgreSQL Flexible Server later.
DATABASE_URL=postgresql://myinvois:myinvois@localhost:5432/myinvois

# Embeddings run locally on CPU — no API key, no per-token cost.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM provider: groq (local dev default) or azure.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Answers only. 30 RPM / 1K RPD / 8K TPM / 200K TPD.
GROQ_MODEL=openai/gpt-oss-120b
# Router, grade_docs, rewrite_query and the extractors. Metered separately from
# 120b, so it keeps working when the big model's daily cap is spent.
GROQ_SMALL_MODEL=openai/gpt-oss-20b

# Azure AI Foundry (used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Stop before Groq does: 75% of the 200K TPD cap, so users get our message
# rather than a provider 429 mid-answer. Counted from LLM usage metadata and
# stored in Postgres, so it survives container restarts.
DAILY_TOKEN_BUDGET=150000

# LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=myinvois-copilot
